---
import PageLayout from '../../layouts/PageLayout.astro';
import { Code } from 'astro:components';
import { getCollection } from "astro:content";
import PodEpisode from '../../components/PodEpisode.astro';

const pageTitle = "The Bad Take Podcast Archives - Thamara Kandabada";
const allPosts = await getCollection("podcast");
const sortedPosts = allPosts.sort((a, b) => Date.parse(b.data.pubDate) - Date.parse(a.data.pubDate));
const slashpageImage = "/featured-images/podcast.png"
---
<PageLayout title={pageTitle} image={slashpageImage}>
<div class="h-feed">
    <h1 class="p-name">The Bad Take Podcast Archives</h1>
    <a class="p-author h-card" href="https://thamara.co.uk/" hidden>Thamara Kandabada</a>
   
    <p>This is the complete archive of the conversational podcast I co-hosted with <a href="https://himalkk.substack.com/" target="_blank">Himal Kotelawala</a>. The podcast was active from 2018–2022. Originally hosted on Anchor, it was distributed on most podcast platforms using Anchor’s syndication tools. The show is archived here for posterity, complete with the original show notes first published at <Code code=`thebadtake.com` inline />.</p>
    <p>The podcast was effectively discontinued in 2022, however, Himal and I may continue to record and publish irregularly.</p>
    <p>The podcast’s logo was designed by me.</p>

    <div class="podcast-grid">
        {sortedPosts.map((post: any) => <PodEpisode pubDate={post.data.pubDate} url={`/projects/podcast/${post.id}/`} title={post.data.title} guest={post.data.guest} episode={post.data.episode} />)}
    </div>
</div>
</PageLayout>
