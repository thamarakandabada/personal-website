---
import PageLayout from '../layouts/PageLayout.astro';

const pageTitle = "Coffee - Thamara Kandabada";
const slashpageImage = "/featured-images/coffee.png";
---
<PageLayout title={pageTitle} image={slashpageImage}>
  <h1>Coffee</h1>
  <p>I love coffee! ☕ I will take it in any form, any time, anywhere. I'm not a coffee snob, I don't discriminate. Instant, drip, cold-brew, filtered—I like it all.</p>
  <p>At coffee shops, I mostly find myself ordering:</p>
  <ul>
    <li>Mochas</li>
    <li>Cappuccinos</li>
    <li>Americanos</li>
  </ul>
  <p>I am also partial to hazelnut syrup in my coffee.</p>
</PageLayout>