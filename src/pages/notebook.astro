---
import { getCollection } from "astro:content";
import PageLayout from '../layouts/PageLayout.astro';
import BlogPost from '../components/BlogPost.astro';

const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort((a, b) => Date.parse(b.data.pubDate) - Date.parse(a.data.pubDate));
const topics = [...new Set(allPosts.map((post) => post.data.topics).filter(Boolean).flat())];
const pageTitle = "Notebook - Thamara Kandabada";
---
<PageLayout title={pageTitle}>  
  <body>

    <h1>Notebook</h1>
    <p class="blog-banner">Welcome to my personal blog. Here you can find my uncensored thoughts on <a href="/notebook/sections/life">Life</a>, <a href="/notebook/sections/the-universe">The Universe</a>, and <a href="/notebook/sections/everything-else">Everything</a>. There is also a <a href="/notebook/sections/microblog">Microblog</a> section for shorter musings and more frequent updates.</p>
    
    <div class="notebook-grid">
      <div>
        <h2>Latest Posts</h2>
          <ul class="notebook-post-list">
            {sortedPosts.map((post: any) => <BlogPost pubDate={post.data.pubDate} url={`/notebook/${post.id}/`} title={post.data.title} description={post.data.description} sections={post.data.sections} />)}
          </ul>
       </div>

      <div class="notebook-subgrid">
        <div>
          <h2>Subscribe</h2>
          <p>Susbcribe using SubToMe or access the raw RSS feed link below.</p>
        </div>
        <div>
          <h2>Topics</h2>
            <div class="tags">
              {topics.map((topic) => <p class="tag"><a href={`/notebook/topics/${String(topic).toLowerCase().replace(/\s+/g, '-')}/`}>{topic}</a></p>)}
            </div>
        </div>
        <div>
          <h2>Search Blog</h2>
        </div>
      </div>
    </div>
    
  </body>
</PageLayout>