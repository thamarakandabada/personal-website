---
import PageLayout from '../../../layouts/PageLayout.astro';
import Gig from '../../../components/Gig.astro';
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const allGigs = await getCollection('gigs');
  allGigs.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  const gigYears = new Map();

  allGigs.forEach((post) => {
    const year = post.data.date.getFullYear();

    if (!gigYears.get(year)) {
      gigYears.set(year, []);
    }

    gigYears.get(year).push(post);
  });

  return [...gigYears.entries()].map(([year, posts]) => ({
    params: { year: String(year) },
    props: { posts }
  }));
};

const { year } = Astro.params;
const { posts } = Astro.props;
const slashpageImage = "/featured-images/gigs.png";
---
<PageLayout title={`Gigs in ${year} - Thamara Kandabada`}>
    <h1>Gigs in {year}</h1>
    <div class="gigs-grid">
      {posts.map((post: any) => <Gig date={post.data.date} title={post.data.title} venue={post.data.venue} description={post.data.description} label={post.data.label} imageUrl={post.data.imageUrl} imageAlt={post.data.imageAlt} support={post.data.support} city={post.data.city} />)}
    </div>
</PageLayout>