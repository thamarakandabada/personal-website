---
import { getCollection, render } from 'astro:content';
import GigLayout from '../../layouts/GigLayout.astro';
import UpcomingGigLayout from '../../layouts/UpcomingGigLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('gigs');
  return posts.map(post => ({
    params: { slug: post.id }, props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

let Layout = post.data.upcoming ? UpcomingGigLayout : GigLayout;
---

<Layout frontmatter={post.data}>
  <Content />
</Layout>