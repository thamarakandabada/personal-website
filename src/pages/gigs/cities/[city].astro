---
import { getCollection } from "astro:content";
import PageLayout from '../../../layouts/PageLayout.astro';
import Gig from '../../../components/Gig.astro';

export async function getStaticPaths() {
  const allGigs = await getCollection("gigs");
  allGigs.sort((a, b) => {
    const dateA = new Date(a.data.date).valueOf();
    const dateB = new Date(b.data.date).valueOf();
    return dateB - dateA;
  });
  const uniqueCities = [...new Set(allGigs.map((gig) => gig.data.city).filter(Boolean))];

return uniqueCities.map((city) => {
  const filteredGigs = allGigs.filter((gig) => gig.data.city === city);
  return {
    params: { city: String(city).toLowerCase().replace(/\s+/g, '-') },
    props: { page: { data: filteredGigs }, displayCity: city },
  };
});
}

const { page, displayCity } = Astro.props;
---
<PageLayout title={`City: ${displayCity} - Gigs - Thamara Kandabada`}>
  <h1>City: <em>{displayCity}</em></h1>
    <div class="gigs-grid">
      {page.data.map((post: any) => <Gig date={post.data.date} title={post.data.title} venue={post.data.venue} description={post.data.description} label={post.data.label} imageUrl={post.data.imageUrl} imageAlt={post.data.imageAlt} support={post.data.support} city={post.data.city} />)}
    </div>
</PageLayout>