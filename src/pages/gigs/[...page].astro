---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import PageLayout from '../../layouts/PageLayout.astro';
import Gig from '../../components/Gig.astro';

export const getStaticPaths = (async ({paginate}) => {
  const gigs = (await getCollection('gigs'))
    .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));

  return paginate(gigs, { pageSize: 12 } );
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const allGigs = await getCollection("gigs");
const pageNumbers = Array.from({length: page.lastPage}, (_, i) => i + 1);
const pageTitle = "Gigs - Thamara Kandabada";
const years = [...new Set(allGigs.map((post) => post.data.date.getFullYear()).flat())]
const sortedYears = years.sort((a, b) => b - a);
const labels = [...new Set(allGigs.map((post) => post.data.label).filter(Boolean).flat())]
const cities = [...new Set(allGigs.map((post) => post.data.city).filter(Boolean).flat())]
---
<PageLayout title={pageTitle}>
  <div class="h-feed">
    <h1 class="p-name">Gigs</h1>
    <a class="p-author h-card" href="https://thamara.co.uk/" hidden>Thamara Kandabada</a>
    <p>This is a timeline of the gigs I have been to. It includes music, theatre, comedy, and many other kinds of performance art. My pre-2022 records are incomplete—I have only added the gigs that I remember.</p>
    <p>Where support acts are mentioned, I've only included the ones I saw.</p>
    <p>These updates have an RSS feed, <a href="/gigs/rss.xml">subscribe here</a>.</p>

    <div class="gigs-filter">
    <div>
    <h2>Browse by year</h2>
    <div class="tags">
		{sortedYears.map((year) => <p class="tag"><a href={`/gigs/years/${String(year)}/`}>{year}</a></p>)}
    </div>
    </div>

    <div>
    <h2>Browse by label</h2>
    <div class="tags">	
		{labels.map((label) => <p class="tag"><a href={`/gigs/labels/${String(label).toLowerCase().replace(/\s+/g, '-')}/`}>{label}</a></p>)}
    </div>
    </div>

    <div>
    <h2>Browse by city</h2>
    <div class="tags">
		{cities.map((city) => <p class="tag"><a href={`/gigs/cities/${String(city).toLowerCase().replace(/\s+/g, '-')}/`}>{city}</a></p>)}
    </div>
    </div>
    </div>

    <div class="gigs-grid">
      {page.data.map((post: any) => <Gig date={post.data.date} title={post.data.title} venue={post.data.venue} description={post.data.description} label={post.data.label} imageUrl={post.data.imageUrl} imageAlt={post.data.imageAlt} support={post.data.support} />)}
    </div>
    
    <div class="pagination-links">
      {
        (page.lastPage > 1) && (
        <nav aria-label="Pagination">
          { page.url.prev && ( <a href={page.url.prev}>Previous Page</a> ) }
          { pageNumbers.map((num) => (
            num === page.currentPage
              ? <span aria-current="page">{num}</span>
              : <a href={num === 1 ? '/gigs/' : `/gigs/${num}/`} aria-label={`Page ${num}`}>{num}</a>
            ))
          }
          { page.url.next && ( <a href={page.url.next}>Next Page</a> ) }
       </nav>
      )
      }
    </div>
  </div>
</PageLayout>