---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import PageLayout from '../../layouts/PageLayout.astro';
import Gig from '../../components/Gig.astro';
import UpcomingGig from '../../components/UpcomingGig.astro';

export const getStaticPaths = (async ({paginate}) => {
  const pastGigs = (await getCollection('gigs'))
    .filter(post => !post.data.upcoming)
    .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));

  return paginate(pastGigs, { pageSize: 20 } );
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const allGigs = await getCollection("gigs");
const upcomingGigs = allGigs.filter(post => post.data.upcoming).sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
const pageNumbers = Array.from({length: page.lastPage}, (_, i) => i + 1);
const pageTitle = "Gigs - Thamara Kandabada";
const years = [...new Set(allGigs.map((post) => post.data.date.getFullYear()).flat())]
const sortedYears = years.sort((a, b) => b - a);
const labels = [...new Set(allGigs.map((post) => post.data.label).filter(Boolean).flat())]
const sortedLabels = labels.sort();
const cities = [...new Set(allGigs.map((post) => post.data.city).filter(Boolean).flat())]
const sortedCities = cities.sort();
const slashpageImage = "/featured-images/gigs.png"
---
<PageLayout title={pageTitle} image={slashpageImage}>
  <div class="h-feed">
    <h1 class="p-name">Gigs</h1>
    <a class="p-author h-card" href="https://thamara.co.uk/" hidden>Thamara Kandabada</a>
    <p>My definition of "gig" in the context of this page is quite broad—it includes music, theatre, comedy, and many other kinds of live performances. This page draws inspiration from <a href="https://lynnandtonic.com/" target="_blank">Lynn Fisher</a>'s excellent <a href="https://concerts.lynnandtonic.com/" target="_blank">concerts page</a>, which in my mind is the gold standard for such pages. You can find more great examples on the <a href="https://indieweb.org/concerts" target="_blank">IndieWeb wiki</a>.</p>
    <p>These updates have an RSS feed, <a href="/gigs/rss.xml">subscribe here</a>.</p>
    <h2>Browse the archive</h2>
    <div class="gigs-filter two-grid">
    <div>
    <h3>By year</h3>
    <div class="tags">
		{sortedYears.map((year) => <p class="tag"><a href={`/gigs/years/${String(year)}/`}>{year}</a></p>)}
    </div>
    </div>

    <div>
    <h3>By type</h3>
    <div class="tags">	
		{sortedLabels.map((label) => <p class="tag"><a href={`/gigs/labels/${String(label).toLowerCase().replace(/\s+/g, '-')}/`}>{label}</a></p>)}
    </div>
    </div>

    <div>
    <h3>By city</h3>
    <div class="tags">
		{sortedCities.map((city) => <p class="tag"><a href={`/gigs/cities/${String(city).toLowerCase().replace(/\s+/g, '-')}/`}>{city}</a></p>)}
    </div>
    </div>

    </div>

    <div>
    <h2>Upcoming gigs</h2>
    <p>Events I've purchased tickets for and look forward to attending.</p>
    <div class="gigs-grid">
      {upcomingGigs.map((gig) => (
        <UpcomingGig
          label={gig.data.label}
          title={gig.data.title}
          venue={gig.data.venue}
          date={gig.data.date}
          city={gig.data.city}
        />
      ))}
    </div>
    </div>
    
    <h2 id="past-gigs">Past gigs</h2>
    <p>Events I've attended, sorted in reverse chronological order. My pre-2022 records are incomplete and I have only added the ones that I remember. I intend to dig through old photos and emails to make this list as comprehensive as possible. Where support acts are mentioned, I've only included the ones I saw live.</p>
    <div class="gigs-grid">
      {page.data.map((post: any) => <Gig date={post.data.date} title={post.data.title} venue={post.data.venue} description={post.data.description} label={post.data.label} imageUrl={post.data.imageUrl} imageAlt={post.data.imageAlt} support={post.data.support} city={post.data.city} url={`/gigs/${post.id}/`} />)}
    </div>
    
    <div class="pagination-links">
      {
        (page.lastPage > 1) && (
        <nav aria-label="Pagination">
          { page.url.prev && ( <a href={`${page.url.prev}#past-gigs`}>Previous Page</a> ) }
          { pageNumbers.map((num) => (
            num === page.currentPage
              ? <span aria-current="page">{num}</span>
              : <a href={num === 1 ? '/gigs#past-gigs' : `/gigs/${num}#past-gigs`} aria-label={`Page ${num}`}>{num}</a>
            ))
          }
          { page.url.next && ( <a href={`${page.url.next}#past-gigs`}>Next Page</a> ) }
       </nav>
      )
      }
    </div>
  </div>
</PageLayout>