---
import PageLayout from '../layouts/PageLayout.astro';
import { Picture } from 'astro:assets';
import coverImage from '../assets/images/main/thamara-kandabada.jpg';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .filter(post => !post.data.sections?.includes('Stream'))
  .slice(0,6);
const pageTitle = "Thamara Kandabada - Generalist. Tinkerer.";
---

<PageLayout 
  title={pageTitle}
  feeds={[
    { title: "Notebook - Thamara Kandabada (All Posts)", href: "/notebook/rss.xml" },
    { title: "Notebook - Thamara Kandabada (Life)", href: "/notebook/sections/life/rss.xml" },
    { title: "Notebook - Thamara Kandabada (The Universe)", href: "/notebook/sections/the-universe/rss.xml" },
    { title: "Notebook - Thamara Kandabada (Everything Else)", href: "/notebook/sections/everything-else/rss.xml" },
    { title: "Notebook - Thamara Kandabada (Stream)", href: "/notebook/sections/stream/rss.xml" },
    { title: "Design - Thamara Kandabada", href: "/design/rss.xml" },
    { title: "Desk - Thamara Kandabada", href: "/desk/rss.xml" },
    { title: "Gigs - Thamara Kandabada", href: "/gigs/rss.xml" }
  ]}
>

  <h1>Greetings, friends & strangers.</h1>
  <div class="h-card">
  <div class="home-page-hero">
    <div class="home-page-hero-intro">
      <p><span id="day">Hello</span> and welcome to my personal website.</p>
      <p><span class="p-note">I’m Thamara, <a href="/resume">furniture-peddler</a> by day and <a href="/now">wearer-of-many-hats</a> by night. I like to watch films, enjoy live music, tinker with this website, play guitar, and run in my free time. I'm currently based in Belfast, Northern Ireland.</span></p>
      <p>I’ve had a website since 2014, which was when I first learned the basics of web design—specifically, HTML, CSS, and WordPress. This is the fourth or fifth iteration; I’ve now lost count.</p>
      <p>You can learn more about how this site is built in <a href="/colophon">the colophon</a>, or explore below. Bust most importantly, thank you for visiting. Please consider signing my <a href="/guestbook">guestbook</a>, I'd love to know what you thought of it.</p>
    </div>

    <!-- My h-card -->
      <div style="display: none;">
        <a class="p-name u-url u-uid" href="https://thamara.co.uk/" rel="me">Thamara Kandabada</a>
        <p class="p-note">Generalist. Tinkerer.</p>
        <a class="u-email" href="mailto:t@thamara.co.uk">e</a>
        <!-- location -->
        <div>
          <span class="p-locality">Belfast</span>, 
          <span class="p-region">Northern Ireland</span>, 
          <span class="p-country-name">United Kingdom</span>
        </div>
        <!-- identity -->
          <p class="p-sex">Male</p>
          <p class="p-gender-identity">Cisgender</p>
      </div>

      <div style="display: none;">
        <a rel="me" href="https://github.com/thamarakandabada">GitHub</a>
        <a rel="me" href="https://www.reddit.com/user/thamara-k/">Reddit</a>
        <a rel="me" href="https://www.linkedin.com/in/thamarakandabada/">LinkedIn</a>
      </div>

    <div class="home-page-hero-image">
    <figure>
      <Picture
      class="u-photo"
      src={coverImage}
      alt="Me sitting behind the drum set at the Casbah Coffee Club in Liverpool, the birthplace of The Beatles."
      formats={['avif', 'webp']}
      />
    <figcaption>No, I can't play the drums.</figcaption>
    </figure>
    </div>
    </div>
  
  </div>

  <h2>Explore my digital garden</h2>

  <div class="homepage-flex">
    <div  class="featured-pages">   
      <h3>At a glance</h3>
        <ul class="featured-pages-list">
          <li><a href="/resume">Resume</a></li>
          <li><a href="/now">What I'm up to</a></li>
          <li><a href="/uses">What I'm using</a></li>
          <li><a href="/gigs">Gigs I've been to</a></li>
          <li><a href="https://physicalmedia.thamara.co.uk">Blu-ray collection</a></li>
          <li><a href="/hello">Say hello</a></li>
          <li><em><strong><a href="/slashpages">More pages</a></strong></em></li>
        </ul>
    </div>
    <div class="recent-blogposts">
      <h3>From the notebook</h3>
        <ul class="recent-blogposts-list">
              {posts.map(post => (
              <li><a href={`/notebook/${post.id}`}>{post.data.title}</a></li>
              ))}
          <li><em><strong><a href="/notebook">More posts</a></strong></em></li>
        </ul>
    </div>
    <div class="webrings">
      <h3>See the neighbourhood</h3>
        <p>This website is part of the <a href="https://xn--sr8hvo.ws">IndieWeb Webring</a>. View more sites like this below.</p>
        <ul class="webring-links">
          <li><a href="https://xn--sr8hvo.ws/previous">Previous</a></li>
          <li><a href="https://xn--sr8hvo.ws/random">Random</a></li>
          <li><a href="https://xn--sr8hvo.ws/next">Next</a></li>
        </ul>
    </div>
  </div>

  <script is:inline>
  document.getElementById("day").innerText = "Happy " + ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"].at(new Date().getDay() - 1);
  </script>
</PageLayout>