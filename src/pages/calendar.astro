---
import PageLayout from '../layouts/PageLayout.astro';

const pageTitle = "Calendar - Thamara Kandabada";
const slashpageImage = "/featured-images/calendar.png";
---
<PageLayout title={pageTitle} image={slashpageImage}>
  <h1>Calendar</h1>
  <p>I don't care for <a href="/notebook/2026/06/birthday">birthdays</a>, but I celebrate the following.</p>
  <h2>February</h2>
  <ul>
    <li><strong>2 Feb:</strong> <a href="https://en.wikipedia.org/wiki/Groundhog_Day" target="_blank">Groundhog Day</a></li>
    <li><strong>22 Feb:</strong> <a href="https://youtu.be/PZHKkOQ86oE" target="_blank">Hot Fuzz birthday</a></li>
  </ul>
  <h2>March</h2>
  <ul>
    <li><strong>25 Mar:</strong> <a href="https://tolkiengateway.net/wiki/25_March" target="_blank">The destruction of the One Ring</a></li>
    <li><strong>31 Mar:</strong> <a href="https://en.wikipedia.org/wiki/94_Meetings" target="_blank">93 Meetings Day</a></li>
  </ul>
  <h2>May</h2>
  <ul>
    <li><strong>1 May:</strong> <a href="https://en.wikipedia.org/wiki/Chungking_Express" target="_blank">He Zhi Wu's Birthday</a></li>
    <li><strong>4 May:</strong> <a href="https://en.wikipedia.org/wiki/Star_Wars_Day" target="_blank">Star Wars Day</a></li>
    <li><strong>25 May:</strong> <a href="https://en.wikipedia.org/wiki/Towel_Day" target="_blank">Towel Day</a></li>
  </ul>
  <h2>July</h2>
  <ul>
    <li><strong>31 Jul:</strong> <a href="https://indieweb.org/send_a_friend_a_webmention_day" target="_blank">Send a Friend a Webmention Day</a></li>
  </ul>
  <h2>September</h2>
  <ul>
    <li><strong>26 Sep:</strong> <a href="https://thelastofus.fandom.com/wiki/Outbreak_Day" target="_blank">Outbreak Day</a></li>
  </ul>
  <h2>December</h2>
  <ul>
    <li><strong>23 Dec:</strong> <a href="https://en.wikipedia.org/wiki/Festivus" target="_blank">Festivus</a></li>
  </ul>
</PageLayout>