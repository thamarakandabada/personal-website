---
import PageLayout from '../layouts/PageLayout.astro';
import { Picture } from 'astro:assets';
import mapImage from '../assets/images/404/mapImage.jpg';

const pageTitle = "Turn back - Thamara Kandabada";
---
<PageLayout title={pageTitle}>
    <div class="four-o-four">
    <h1>Hic Sunt Dracones</h1>
    <figure>
    <Picture
      src={mapImage} alt="A scarce circular woodblock world map"
      formats={['avif', 'webp']}
    />
    <figcaption><a href="https://commons.wikimedia.org/wiki/File:Medieval_woodblock_T-O_world_map_Altea_Gallery.jpg">AnonymousUnknown author</a>, Public domain, via Wikimedia Commons</figcaption>
    </figure>
    <p>You have wandered too far off the map. It's not safe here. Turn back, before it's too late.</p>
    <div class="see-also">
      <ul>
        <li><strong>You can:</strong></li>
        <li><a href="/"><i class="bi bi-house-door"></i> Go back home</a></li>
        <li><a href="/hello"><i class="bi bi-fire"></i> Light a beacon</a></li>
        <li><a href="/notebook"><i class="bi bi-book"></i> Read the scrolls</a></li>
      </ul>
    </div>
    </div>
</PageLayout>