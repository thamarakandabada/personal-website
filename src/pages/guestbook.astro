---
import PageLayout from '../layouts/PageLayout.astro';

const pageTitle = "Guestbook - Thamara Kandabada";
const slashpageImage = "/featured-images/guestbook.png";
---
<PageLayout title={pageTitle} image={slashpageImage}>
  
    <h1>Guestbook</h1>
    
    <p>If you enjoyed browsing the website, please consider signing my guestbook below. You can also sign by sending me an <a href="mailto:t@thamara.co.uk">email</a> or a <a href="https://webmention.io/thamara.co.uk/webmention" target="_blank">webmention</a>.</p>

<!-- Discuss comment widget -->
<link rel="stylesheet" href="https://discuss.thamara.co.uk/client.css">
<div id="discuss-comments" data-dark-selector=".dark"></div>
<script is:inline src="https://discuss.thamara.co.uk/client.js"></script>
<script>
  new DiscussWidget({
    container: document.getElementById('discuss-comments'),
    serverUrl: 'https://discuss.thamara.co.uk',
	darkSelector: '.dark',
	title: 'Leave a note',
  });
</script>

</PageLayout>
