---
import PageLayout from '../../../layouts/PageLayout.astro';
const pageTitle = "Topics - Thamara Kandabada";
import { getCollection } from "astro:content";
const allPosts = await getCollection("blog");
const topics = [...new Set(allPosts.map((post) => post.data.topics).filter(Boolean).flat())];
---
<PageLayout title={pageTitle}>
  <h1>Topics</h1>
  <p>Welcome to the topics page!</p>
  <div class="tags">
    {topics.map((topic) => <p class="tag"><a href={`/notebook/topics/${String(topic).toLowerCase().replace(/\s+/g, '-')}/`}>{topic}</a></p>)}
  </div>
</PageLayout>