---
import { getCollection } from "astro:content";
import PageLayout from '../../../layouts/PageLayout.astro';
import BlogPost from '../../../components/BlogPost.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const uniqueTags = [...new Set(allPosts.map((post: any) => post.data.sections).flat())];

return uniqueTags.map((section) => {
  const filteredPosts = allPosts.filter((post: any) => post.data.sections.includes(section));
  return {
    params: { section },
    props: { posts: filteredPosts },
  };
});
}

const { section } = Astro.params;
const { posts } = Astro.props;
---
<PageLayout title={`Section: ${section} - Thamara Kandabada`}>
  <h1>Section: <em>{section}</em></h1>
  <ul>
  {posts.map((post: any) => <BlogPost url={`/notebook/${post.id}/`} title={post.data.title} />)}
  </ul>
</PageLayout>