---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import PageLayout from '../../layouts/PageLayout.astro';
import BlogPost from '../../components/BlogPost.astro';

export const getStaticPaths = (async ({paginate}) => {
  const posts = (await getCollection('blog'))
    .sort((a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0));
  
  const publishedPosts = posts.filter(post => !post.data.draft);
  return paginate(publishedPosts, { pageSize: 15 } );
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const pageNumbers = Array.from({length: page.lastPage}, (_, i) => i + 1);
const pageTitle = "Notebook - Thamara Kandabada";
---
<PageLayout title={pageTitle}>
  <div class="h-feed">
    <h1 class="p-name">Notebook</h1>
    <p class="blog-banner">Welcome to my personal blog. Here you can find my uncensored thoughts on <a href="/notebook/sections/life">Life</a>, <a href="/notebook/sections/the-universe">The Universe</a>, and <a href="/notebook/sections/everything-else">Everything</a>. There is also a <a href="/notebook/sections/stream">Stream</a> section for shorter musings and more frequent updates.</p>
    
    <div class="notebook-grid">
      <a class="p-author h-card" href="https://thamara.co.uk/" hidden>Thamara Kandabada</a>
      <div>
        <h2>Latest Posts</h2>
          <ul class="notebook-post-list">
            {page.data.map((post: any) => <BlogPost pubDate={post.data.pubDate} url={`/notebook/${post.id}/`} title={post.data.title} description={post.data.description} sections={post.data.sections} />)}
          </ul>

          <div class="pagination-links">
            {
              (page.lastPage > 1) && (
              <nav aria-label="Pagination">
               { page.url.prev && ( <a href={page.url.prev}>Previous Page</a> ) }
               { pageNumbers.map((num) => (
                 num === page.currentPage
                 ? <span aria-current="page">{num}</span>
                 : <a href={num === 1 ? '/notebook/' : `/notebook/${num}/`} aria-label={`Page ${num}`}>{num}</a>
              ))
              }
              { page.url.next && ( <a href={page.url.next}>Next Page</a> ) }
              </nav>
            )
            }
          </div>

      </div>

      <div class="notebook-subgrid">
        <div>
          <h2>Subscribe</h2>
          <p>Susbcribe using SubToMe or access the raw RSS feed link below. Go to the <a href=/feeds>/Feeds</a> page for more granular feed options.</p>
          <div class="subscribe-buttons">
          <button type="button">SubToMe</button>
            <a href="/notebook/rss.xml"><button type="button"><i class="bi bi-rss-fill"></i></button></a>
          </div>
        </div>

        <div>
          <h2>Stats</h2>
        </div>

        <div>
          <h2>Search Blog</h2>
        </div>

        <div>
          <h2>Archives</h2>
          <p>View the full post archives to browse by section, topic, and year.</p>
          <p><a href="/notebook/archives">Visit the archives</a></p>
        </div>
      </div>
    </div>
  </div>
</PageLayout>