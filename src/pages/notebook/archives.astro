---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import BlogPost from '../../components/BlogPost.astro';

const pageTitle = "Notebook Archives - Thamara Kandabada";
const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort((a, b) => Date.parse(b.data.pubDate) - Date.parse(a.data.pubDate));
const publishedPosts = allPosts.filter(post => !post.data.draft);
const topics = [...new Set(allPosts.map((post) => post.data.topics).filter(Boolean).flat())];
const sections = [...new Set(allPosts.map((post) => post.data.sections).filter(Boolean).flat())];
const sortedSections = sections.sort((a, b) => {
  const order = ['Life', 'The Universe', 'Everything Else', 'Stream'];
  return order.indexOf(a) - order.indexOf(b);
});
const years = [...new Set(allPosts.map((post) => post.data.pubDate.getFullYear()).flat())]
---
<PageLayout title={pageTitle}>
  <h1>Notebook Archives</h1>

  <h2>Browse by section</h2>
  <div class="tags">
    {sortedSections.map((section) => <p class="tag"><a href={`/notebook/sections/${String(section).toLowerCase().replace(/\s+/g, '-')}/`}>{section}</a></p>)}
  </div>

  <h2>Browse by topic</h2>
  <div class="tags">
    {topics.map((topic) => <p class="tag"><a href={`/notebook/topics/${String(topic).toLowerCase().replace(/\s+/g, '-')}/`}>{topic}</a></p>)}
  </div>

  <h2>Browse by year</h2>
  <div class="tags">
    {years.map((year) => <p class="tag"><a href={`/notebook/years/${String(year)}/`}>{year}</a></p>)}
  </div>

  <h2>All posts</h2>
    <ul class="notebook-post-list">
      {publishedPosts.map((post) => ( <BlogPost pubDate={post.data.pubDate} url={`/notebook/${post.id}/`} title={post.data.title} description={post.data.description} sections={post.data.sections} />))}
    </ul>
</PageLayout>