---
import { getCollection, render } from 'astro:content';
import BlogLayoutNoImage from '../../layouts/BlogLayoutNoImage.astro';
import BlogLayoutwithImage from '../../layouts/BlogLayoutwithImage.astro';
import StreamLayout from '../../layouts/StreamLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id }, props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

let Layout;
if (!post.data.title) {
  Layout = StreamLayout;
} else if (post.data.imageUrl) {
  Layout = BlogLayoutwithImage;
} else {
  Layout = BlogLayoutNoImage;
}
---

<Layout frontmatter={post.data}>
  <Content />
</Layout>