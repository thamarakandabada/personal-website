---
interface Props {
  targetUrl?: string;
}

// Automatically use the current page URL if targetUrl isn't explicitly passed
const { targetUrl = Astro.url.href } = Astro.props;

const domain = "thamara.co.uk";
const apiUrl = `https://webmention.io/api/mentions.jf2?domain=${domain}`;

let allMentions = [];

try {
  const response = await fetch(apiUrl);
  if (response.ok) {
    const data = await response.json();
    allMentions = data.children || [];
  }
} catch (error) {
  console.error("Failed to fetch webmentions:", error);
}

const cleanTarget = targetUrl.replace(/\/$/, "");

const mentions = allMentions.filter(m => {
  const mentionTarget = (m['wm-target'] || '').replace(/\/$/, "");
  return mentionTarget === cleanTarget;
});

const likes = mentions.filter(m => m['wm-property'] === 'like-of');
const reposts = mentions.filter(m => m['wm-property'] === 'repost-of');
const replies = mentions.filter(m => m['wm-property'] === 'in-reply-to' || m['wm-property'] === 'mention-of');

const MAX_LENGTH = 200;
---

{mentions.length > 0 && (
  <section class="webmentions-section">
    <h3>Webmentions</h3>

    {/* Likes & Reposts Section */}
    {(likes.length > 0 || reposts.length > 0) && (
      <div class="mention-icons">
        <p>{likes.length} Likes & {reposts.length} Reposts</p>
        <div class="avatar-list">
          {likes.concat(reposts).map(mention => (
            <a href={mention.author?.url || mention.url} target="_blank" rel="noopener noreferrer" title={mention.author?.name}>
              {mention.author?.photo && (
                <img src={mention.author.photo} alt={mention.author.name} width="32" height="32" class="avatar" />
              )}
            </a>
          ))}
        </div>
      </div>
    )}

    {/* Comments & Replies Section */}
    {replies.length > 0 && (
      <div class="mention-threads">
        <h4>Replies & Mentions</h4>
        <ul>
          {replies.map(mention => {
            const rawText = mention.content?.text || '';
            const truncatedText = rawText.length > MAX_LENGTH 
              ? rawText.slice(0, MAX_LENGTH).trim() + '…' 
              : rawText;

            return (
              <li class="mention-card">
                <div class="mention-author">
                  {mention.author?.photo && (
                    <img src={mention.author.photo} alt="" width="40" height="40" class="avatar" />
                  )}
                  <a href={mention.author?.url || mention.url} target="_blank" rel="noopener noreferrer">
                    <strong>{mention.author?.name || 'Anonymous'}</strong>
                  </a>
                </div>
                <p>{truncatedText}</p>
                <a href={mention.url} target="_blank" rel="noopener noreferrer">View original response</a>
              </li>
            );
          })}
        </ul>
      </div>
    )}
  </section>
)}