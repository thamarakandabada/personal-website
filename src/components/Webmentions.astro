---
interface Props {
  targetUrl?: string;
}

const { targetUrl = Astro.url.href } = Astro.props;

// Strip any existing slash, then create both variations
const cleanTarget = targetUrl.replace(/\/$/, "");
const targetWithSlash = cleanTarget + "/";

const apiWithoutSlash = `https://webmention.io/api/mentions.jf2?target=${encodeURIComponent(cleanTarget)}`;
const apiWithSlash = `https://webmention.io/api/mentions.jf2?target=${encodeURIComponent(targetWithSlash)}`;

let mentions = [];

try {
  // Fetch both endpoints at the same time
  const [res1, res2] = await Promise.all([
    fetch(apiWithoutSlash),
    fetch(apiWithSlash)
  ]);

  const data1 = res1.ok ? await res1.json() : { children: [] };
  const data2 = res2.ok ? await res2.json() : { children: [] };

  // Combine results
  const combinedMentions = [...(data1.children || []), ...(data2.children || [])];

  // Remove potential duplicates using the unique 'wm-id'
  const uniqueMentionsMap = new Map(combinedMentions.map(m => [m['wm-id'], m]));
  mentions = Array.from(uniqueMentionsMap.values());

} catch (error) {
  console.error("Failed to fetch webmentions:", error);
}

// --- DIAGNOSTIC LOGS ---
console.log(`--- WEBMENTION DEBUG for ${cleanTarget} ---`);
console.log(`Found ${mentions.length} total mentions across both slash variations.`);
// -----------------------

const likes = mentions.filter(m => m['wm-property'] === 'like-of');
const reposts = mentions.filter(m => m['wm-property'] === 'repost-of');
const replies = mentions.filter(m => m['wm-property'] === 'in-reply-to' || m['wm-property'] === 'mention-of');

const MAX_LENGTH = 200;
---

{mentions.length > 0 && (
  <section class="webmentions-section">
    <h3>Around the web</h3>

    {(likes.length > 0 || reposts.length > 0) && (
      <div class="mention-icons">
        <p>{likes.length} Likes & {reposts.length} Reposts</p>
        <div class="avatar-list not-a">
          {likes.concat(reposts).map(mention => (
            <a href={mention.author?.url || mention.url} target="_blank" rel="noopener noreferrer" title={mention.author?.name}>
              {mention.author?.photo && (
                <img src={mention.author.photo} alt={mention.author.name} width="32" height="32" class="avatar" />
              )}
            </a>
          ))}
        </div>
      </div>
    )}

    {replies.length > 0 && (
      <div class="mention-threads">
        <h4>Replies & Mentions</h4>
        <ul>
          {replies.map(mention => {
            const rawText = mention.content?.text || '';
            const truncatedText = rawText.length > MAX_LENGTH 
              ? rawText.slice(0, MAX_LENGTH).trim() + '…' 
              : rawText;

            return (
              <li class="mention-card">
                <div class="mention-author">
                  {mention.author?.photo && (
                    <img src={mention.author.photo} alt="" width="40" height="40" class="avatar" />
                  )}
                  <a href={mention.author?.url || mention.url} target="_blank" rel="noopener noreferrer">
                    <strong>{mention.author?.name || 'Anonymous'}</strong>
                  </a>
                </div>
                <p>{truncatedText}</p>
                <a href={mention.url} target="_blank" rel="noopener noreferrer">Original response</a>
              </li>
            );
          })}
        </ul>
      </div>
    )}
  </section>
)}