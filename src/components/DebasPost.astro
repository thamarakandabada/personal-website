---
const { title, url, pubDate, author } = Astro.props;
---
<div class="h-entry">
  <a class="u-url" href={url}>
    <p class="debas-author p-author">{author}</p>
    <h2 class="p-name">{title}</h2>
    <p class="debas-date"><time class="dt-published" datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('en-GB', {day: 'numeric', month: 'short', year: 'numeric'})}</time></p>
  </a>
</div>  