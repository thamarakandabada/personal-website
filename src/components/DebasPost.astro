---
const { title, url, pubDate, author } = Astro.props;
---
<div class="h-entry grid-box">
  <a class="u-url" href={url}>
    <p class="pubdate"><time class="dt-published" datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('en-GB', {day: 'numeric', month: 'short', year: 'numeric'})}</time></p>
    <h2 class="p-name">{title}</h2>
    <h3 class="p-author">{author}</h3>
  </a>
</div>  