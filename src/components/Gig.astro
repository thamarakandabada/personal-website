---
import { Picture } from "astro:assets";

const { imageUrl, imageAlt, label, title, description, venue, date, support } = Astro.props;
---

<div class="gig-timeline-node">
  <div class="gig-photo">
    <Picture
      src={imageUrl}
      formats={['avif', 'webp']}
		  alt={imageAlt}
    />
  </div>
  <div class="gig-label">
    <p>{label}</p>
  </div>
  <p class="gig-title">{title}</p>
  <p class="gig-support">{support}</p>
  <p class="gig-description">{description}</p>
  <p class="gig-date">{date.toLocaleDateString('en-GB', {day: 'numeric', month: 'short', year: 'numeric'})} at <span class="gig-venue">{venue}</span></p>
</div>