---
const { label, title, venue, date, city } = Astro.props;
---
<div class="grid-box h-event">
  <div class="content-label-top">
    <p>{label}</p>
  </div>
  <h3 class="p-name">{title}</h3>
  <p class="pubdate"><time class="dt-start" datetime={date.toISOString()}>
    {date.toLocaleDateString('en-GB', {day: 'numeric', month: 'short', year: 'numeric'})}
  </time> at <span class="p-location">{venue}, {city}</span></p>
</div>