---
import "../styles/global.css";
import { Picture } from 'astro:assets';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from "@vercel/speed-insights/astro";
import Navigation from "../components/TopNavigation.astro";
import GlobalFooter from "../components/GlobalFooter.astro";
const { frontmatter } = Astro.props;
const formattedDate = frontmatter.pubDate 
  ? new Date(frontmatter.pubDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
  : 'Unknown Date';
---
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width" />
	<link rel="icon" type="image/svg+xml" href="/tk.png" />
	<link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="https://use.typekit.net/lbp7mnn.css">
	<meta name="generator" content={Astro.generator} />
    <Analytics/>
    <SpeedInsights/>
	<title>{frontmatter.title}</title>
</head>
	
<body>	
<Navigation />
    <div class="blog-header">
	  <p><span class="blog-date">{formattedDate}</span>//<span class="blog-category">In {frontmatter.sections?.map((section: string, index: number) => (<><a href={`/notebook/sections/${String(section).toLowerCase().replace(/\s+/g, '-')}/`}>{section}</a></>))}</span></p>
      <h1 class="blog-title">{frontmatter.title}</h1>
	  <p class="blog-description">{frontmatter.description}</p>
	  <p class="blog-author">by {frontmatter.author}</p>
    </div>

	<div class="blog-content">
	  <div class="blog-image">
	  <figure class="blog-hero-image">
      <Picture
        src={frontmatter.imageUrl}
		formats={['avif', 'webp']}
		alt={frontmatter.imageAlt} width="1480" height="1080"
      />
      <figcaption>{frontmatter.imageCaption}</figcaption>
      </figure>
	  </div>
      <slot />
	
    	<div class="topics-list">
		<ul>
		<li><strong>Topics:</strong></li>
		{frontmatter.topics?.map((topic: string) => <li><a href={`/notebook/topics/${String(topic).toLowerCase().replace(/\s+/g, '-')}/`}>{topic}</a></li>)}
		</ul>
	</div>
    </div>
	<GlobalFooter />
</body>
