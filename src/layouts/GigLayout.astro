---
import PageLayout from './PageLayout.astro';
import { Picture } from 'astro:assets';
import GigNavPrevNext from '../components/GigNavPrevNext.astro';

const { frontmatter } = Astro.props;
const formattedDate = frontmatter.date 
  ? new Date(frontmatter.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
  : 'Unknown Date';
const isoDate = frontmatter.date
  ? new Date(frontmatter.date).toISOString()
  : ''; 
---
<PageLayout 
  title={`${frontmatter.title} - Gigs - Thamara Kandabada`}
  description={frontmatter.description} 
  image={frontmatter.imageUrl}
  feeds={[{ title: "Gigs - Thamara Kandabada", href: "/gigs/rss.xml" }]}
>
<article class="h-event h-entry">
  <a class="p-author h-card" href="https://thamara.co.uk/" hidden>Thamara Kandabada</a>
  <a class="u-url" href={Astro.url.href} hidden>Permalink</a>
  <div class="post-header">
    <div class="post-meta">
    <p><span class="pubdate"><time class="dt-start dt-published" datetime={isoDate}>
	    {formattedDate}
	  </time></span> — <span class="post-category p-category">{frontmatter.label}</span></p>
    <h1 class="p-name">{frontmatter.title}</h1>
    <h3 class="post-description p-summary">{frontmatter.support}</h3>  
    <h4 class="p-location">at {frontmatter.venue}, {frontmatter.city}</h4>
  </div>
</div>
  <div>
	  <figure class="post-image u-photo">
      <Picture
        src={frontmatter.imageUrl}
		    formats={['avif', 'webp']}
		    alt={frontmatter.imageAlt}
      />
    </figure>
	</div>
  <div class="e-content">
    <p>{frontmatter.description}</p>
    <slot />
  </div>
  <div class="permalink">
    <p><strong>Permalink:</strong> <textarea>{Astro.url.href}</textarea></p>
  </div>
  <div class="content-nav">
  <GigNavPrevNext />
  </div>
</article>
</PageLayout>