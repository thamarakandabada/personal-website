---
import PageLayout from './PageLayout.astro';
import { Picture } from 'astro:assets';

const { frontmatter } = Astro.props;
const formattedDate = frontmatter.date 
  ? new Date(frontmatter.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
  : 'Unknown Date';
const isoDate = frontmatter.date
  ? new Date(frontmatter.date).toISOString()
  : ''; 
---
<PageLayout 
  title={`${frontmatter.title} - Gigs - Thamara Kandabada`}
  description={frontmatter.description} 
  image={frontmatter.imageUrl}
  feeds={[{ title: "Gigs - Thamara Kandabada", href: "/gigs/rss.xml" }]}
>
<article class="h-entry">
  <a class="p-author h-card" href="https://thamara.co.uk/" hidden>Thamara Kandabada</a>
  <a class="u-url" href={Astro.url.href} hidden>Permalink</a>
  
  <div class="blog-header">
      
	  <p><span class="blog-date"><time class="dt-published" datetime={isoDate}>
	    {formattedDate}
	  </time></span>//<span class="blog-category p-category">{frontmatter.label}</span></p>
    <h1 class="blog-title p-name">{frontmatter.title}</h1>
    <p class="venue">{frontmatter.venue}, {frontmatter.city}</p>
    <p class="blog-description p-summary">{frontmatter.support}</p>
    </div>

	  <div class="blog-image">
	  <figure class="blog-hero-image">
      <Picture
        src={frontmatter.imageUrl}
		formats={['avif', 'webp']}
		alt={frontmatter.imageAlt}
      />
    </figure>
	  </div>
    	  <p>{frontmatter.description}</p>
<div class="e-content">
      <slot />
      </div>
        <div class="permalink">
  <p><strong>Permalink:</strong> <textarea>{Astro.url.href}</textarea></p>
  </div>
</article>
</PageLayout>