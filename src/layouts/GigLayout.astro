---
import PageLayout from './PageLayout.astro';
import { Picture } from 'astro:assets';

const { frontmatter } = Astro.props;
const formattedDate = frontmatter.date 
  ? new Date(frontmatter.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
  : 'Unknown Date';
---
<PageLayout 
  title={`${frontmatter.title} - Gigs - Thamara Kandabada`}
  description={frontmatter.description} 
  image={frontmatter.imageUrl}
  feeds={[{ title: "Gigs - Thamara Kandabada", href: "/gigs/rss.xml" }]}
>

    <div class="blog-header">
	  <p><span class="blog-date">{formattedDate}</span>//<span class="blog-category">{frontmatter.label}</span></p>
    <h1 class="blog-title">{frontmatter.title}</h1>
    <p class="venue">{frontmatter.venue}</p>
    <p class="blog-description">{frontmatter.support}</p>
    </div>

	  <div class="blog-image">
	  <figure class="blog-hero-image">
      <Picture
        src={frontmatter.imageUrl}
		formats={['avif', 'webp']}
		alt={frontmatter.imageAlt}
      />
    </figure>
	  </div>
    	  <p>{frontmatter.description}</p>

      <slot />

</PageLayout>