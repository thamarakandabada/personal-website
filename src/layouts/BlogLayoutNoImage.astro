---
import "../styles/global.css";
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from "@vercel/speed-insights/astro";
import Navigation from "../components/TopNavigation.astro";
import GlobalFooter from "../components/GlobalFooter.astro";
import BlogPostNavPrevNext from '../components/BlogPostNavPrevNext.astro';

const { frontmatter } = Astro.props;
const formattedDate = frontmatter.pubDate 
  ? new Date(frontmatter.pubDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
  : 'Unknown Date';
---
<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width" />
	<link rel="icon" type="image/svg+xml" href="/tk.png" />
	<link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="preconnect" href="https://p.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/lbp7mnn.css">
	<meta name="generator" content={Astro.generator} />
    <Analytics/>
    <SpeedInsights/>
	<title>{frontmatter.title}</title>
</head>
	
<body>	
<Navigation />
    <div class="blog-header-no-image">
	  <p><span class="blog-date">{formattedDate}</span>//<span class="blog-category">In {frontmatter.sections?.map((section: string, index: number) => (<><a href={`/notebook/sections/${String(section).toLowerCase().replace(/\s+/g, '-')}/`}>{section}</a></>))}</span></p>
      <h1 class="blog-title">{frontmatter.title}</h1>
	  <p class="blog-description">{frontmatter.description}</p>
	  <p class="blog-author">by {frontmatter.author}</p>
    </div>

	<div class="blog-content">
      <slot />
	
    	<div class="topics-list">
		  <ul>
		    <li><strong>Topics:</strong></li>
		      {frontmatter.topics?.map((topic: string) => <li><a href={`/notebook/topics/${String(topic).toLowerCase().replace(/\s+/g, '-')}/`}>{topic}</a></li>)}
		  </ul>
	    </div>

		<div class="post-reference">
			<p><strong>Reference this post:</strong> When referencing this post, I prefer to be called Thamara, Thamara Kandabada, or Thamara's Notebook.<br>Permalink: https://thamara.co.uk/notebook/{Astro.params.slug}</p>
		</div>

		<!-- Discuss comment widget -->
		<div class="discuss-widget">
          <link rel="stylesheet" href="https://discuss.thamara.co.uk/client.css">
          <div id="discuss-comments"></div>
          <script is:inline src="https://discuss.thamara.co.uk/client.js"></script>
          <script>
            new DiscussWidget({
              container: document.getElementById('discuss-comments'),
              serverUrl: 'https://discuss.thamara.co.uk',
              primaryColor: '#2563eb',
            });
          </script>
		</div>

	    <BlogPostNavPrevNext />
    
	</div>
	<GlobalFooter />
</body>
</html>