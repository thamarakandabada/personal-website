---
import "../styles/global.css";
import { Picture } from 'astro:assets';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from "@vercel/speed-insights/astro";
import Navigation from "../components/TopNavigation.astro";
import GlobalFooter from "../components/GlobalFooter.astro";

const { frontmatter } = Astro.props;
const formattedDate = frontmatter.date 
  ? new Date(frontmatter.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
  : 'Unknown Date';
---
<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width" />
	<link rel="icon" type="image/svg+xml" href="/tk.png" />
	<link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="preconnect" href="https://p.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/lbp7mnn.css">
    <link rel="sitemap" href="/sitemap-index.xml" />	
	<meta name="generator" content={Astro.generator} />
    <Analytics/>
    <SpeedInsights/>
	<title>Desk - {frontmatter.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric'})} - Thamara Kandabada</title>
</head>
	
<body>	
<Navigation />
    <div class="blog-header">
	  <p><span class="blog-date">{formattedDate}</span>//<span class="blog-category">{frontmatter.location}</span></p>
    </div>

	<div class="blog-content">
	  <div class="blog-image">
	  <figure class="blog-hero-image">
      <Picture
        src={frontmatter.imageUrl}
		formats={['avif', 'webp']}
		alt={frontmatter.imageAlt}
      />
    </figure>
	  </div>
	  	  <p>{frontmatter.description}</p>
      <slot />

    </div>
	<GlobalFooter />
</body>
</html>