---
import PageLayout from './PageLayout.astro';
import { Picture } from 'astro:assets';

const { frontmatter } = Astro.props;
const formattedDate = frontmatter.pubDate 
  ? new Date(frontmatter.pubDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
  : 'Unknown Date';
const isoDate = frontmatter.pubDate
  ? new Date(frontmatter.pubDate).toISOString() 
  : '';
---
<PageLayout 
  title={`${frontmatter.title} - Debas Archives - Thamara Kandabada`} 
  description={frontmatter.description} 
  image={frontmatter.imageUrl}
>

<article class="h-entry">
<a class="u-url" href={Astro.url.href} hidden>Permalink</a>
<div class="post-header">
  <div class="post-meta">
  <p><span class="pubdate"><time class="dt-published" datetime={isoDate}>{formattedDate}</time></span> — <span class="post-category"><span class="p-category">{frontmatter.language}</span></span></p>
  <h1 class="post-title p-name">{frontmatter.title}</h1>
  <div class="p-author h-card">
    <p class="post-author">by <span class="p-name">{frontmatter.author}</span></p>
  </div>
  </div>
</div>

  <div>
  <figure class="post-image u-photo">
    <Picture
      src={frontmatter.imageUrl}
	  formats={['avif', 'webp']}
	  alt={frontmatter.imageAlt}
    />
    <figcaption>{frontmatter.imageCaption}</figcaption>
  </figure>
  </div>
  <div class="e-content">
  <slot />
  </div>
  <div class="debas-infobox">
    <div class="debas-author-avatar">
	    <Picture
        src={frontmatter.authorPhotoUrl}
		    formats={['avif', 'webp']}
		    alt={frontmatter.authorPhotoAlt}
      />
	  </div>
	  <div class="debas-author-bio">
	    <p>{frontmatter.authorInfo}</p>
	  </div>
    <div class="debas-disclaimer">
	    <p>{frontmatter.disclaimer}</p>
    </div>
  </div>
  <div class="permalink">
  <p><strong>Permalink:</strong> <textarea>{Astro.url.href}</textarea></p>
  </div>
</article>  
</PageLayout>