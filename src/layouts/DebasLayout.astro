---
import PageLayout from './PageLayout.astro';
import { Picture } from 'astro:assets';

const { frontmatter } = Astro.props;
const formattedDate = frontmatter.pubDate 
  ? new Date(frontmatter.pubDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
  : 'Unknown Date';
const isoDate = frontmatter.pubDate
  ? new Date(frontmatter.pubDate).toISOString() 
  : '';
---
<PageLayout 
  title={`${frontmatter.title} - Debas Archives - Thamara Kandabada`} 
  description={frontmatter.description} 
  image={frontmatter.imageUrl}
>

<article class="h-entry">
<a class="u-url" href={Astro.url.href} hidden>Permalink</a>
<div class="blog-header">
  <p><span class="blog-date"><time class="dt-published" datetime={isoDate}>{formattedDate}</time></span>//<span class="blog-category">Language: <span class="p-category">{frontmatter.language}</span></span></p>
  <h1 class="blog-title p-name">{frontmatter.title}</h1>
  <div class="p-author h-card">
    <p class="blog-author">by <span class="p-name">{frontmatter.author}</span></p>
  </div>
</div>

  <div class="blog-image">
  <figure class="blog-hero-image u-photo">
    <Picture
      src={frontmatter.imageUrl}
	  formats={['avif', 'webp']}
	  alt={frontmatter.imageAlt}
    />
    <figcaption>{frontmatter.imageCaption}</figcaption>
  </figure>
  </div>
  <div class="e-content">
  <slot />
  </div>
  <div class="author-info">
    <div class="author-photo">
	  <Picture
        src={frontmatter.authorPhotoUrl}
		formats={['avif', 'webp']}
		alt={frontmatter.authorPhotoAlt}
      />
	</div>
	<div class="author-description">
	  <p>{frontmatter.authorInfo}</p>
	</div>
  </div>
  <div>
	<p class="disclaimer">{frontmatter.disclaimer}</p>
  <div class="permalink">
  <p><strong>Permalink:</strong> <textarea>{Astro.url.href}</textarea></p>
  </div>
  </div>
</article>  
</PageLayout>