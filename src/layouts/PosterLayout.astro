---
import "../styles/global.css";
import { Picture } from 'astro:assets';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from "@vercel/speed-insights/astro";
import Navigation from "../components/TopNavigation.astro";
import GlobalFooter from "../components/GlobalFooter.astro";
import PosterNavPrevNext from '../components/BlogPostNavPrevNext.astro'; 

const { frontmatter } = Astro.props;
const formattedDate = frontmatter.pubDate 
  ? new Date(frontmatter.pubDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
  : 'Unknown Date';
---
<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width" />
	<link rel="icon" type="image/svg+xml" href="/tk.png" />
	<link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="preconnect" href="https://p.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/lbp7mnn.css">
	<meta name="generator" content={Astro.generator} />
    <Analytics/>
    <SpeedInsights/>
	<title>{frontmatter.title} - Design - Thamara Kandabada</title>
</head>
	
<body>	
<Navigation />
    <div class="poster-header">
	  <p><span class="poster-date">{formattedDate}</span>//<span class="poster-category">In {frontmatter.category?.map((category: string, index: number) => (<><a href={`/design/category/${String(category).toLowerCase().replace(/\s+/g, '-')}/`}>{category}</a></>))}</span></p>
      <h1 class="poster-title">{frontmatter.title}</h1>
	  <p class="poster-film-year">{frontmatter.year}</p>
    </div>

	<div class="poster-content">
	  <div class="poster-image">
	  <figure class="poster-hero-image">
      <Picture
        src={frontmatter.imageUrl}
		formats={['avif', 'webp']}
		alt={frontmatter.imageAlt}
      />
      </figure>
	  </div>
      <slot />

	  <PosterNavPrevNext />

    </div>
	<GlobalFooter />
</body>
</html>