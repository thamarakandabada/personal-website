---
import "../styles/index.css";
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from "@vercel/speed-insights/astro";
import Navigation from "../components/TopNavigation.astro";
import GlobalFooter from "../components/GlobalFooter.astro";

interface Props {
    title: string;
    description?: string;
    feeds?: { title: string; href: string }[];
}

const { 
    title,
    description = "Generalist. Tinkerer.",
    feeds = [{ title: "Notebook - Thamara Kandabada", href: "/rss.xml" }] 
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://thamara.co.uk').href;
---

<!doctype html>
  <html lang="en">
    <head>
      <meta charset="UTF-8" />
      <title>{title}</title>
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <link rel="icon" type="image/svg+xml" href="/tk.png" />
      <link rel="sitemap" href="/sitemap-index.xml" />
      <link rel="indieauth-metadata" href="https://indiekey.id/s/v3cpz4n3jc7yzbqv/metadata">
      <link rel="webmention" href="https://webmention.io/thamara.co.uk/webmention" />
      <link rel="pingback" href="https://webmention.io/thamara.co.uk/xmlrpc" />
        
      {feeds.map((feed) => (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={feed.title}
          href={feed.href}
        />
      ))}
        
      <meta name="generator" content={Astro.generator} />
      <meta name="description" content={description} />

      <meta property="og:type" content="website" />
      <meta property="og:url" content={canonicalURL} />
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />

      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:url" content={canonicalURL} />
      <meta name="twitter:title" content={title} />
      <meta name="twitter:description" content={description} />
        
      <Analytics/>
      <SpeedInsights/>
    </head>
    <body>
      <Navigation />
      <section class="page-content">
        <slot />
      </section>   
      <GlobalFooter />
    </body>
  </html>